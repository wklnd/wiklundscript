{
  "name": "wscript",
  "scopeName": "source.wscript",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#types"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.wscript",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.wscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.wscript",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.wscript",
          "match": "\\b(?:var|const|print|if|else|end|repeat|times|as|while|func|object|return)\\b"
        },
        {
          "name": "constant.language.boolean.wscript",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.wscript",
          "match": "\\b(?:\\d+\\.\\d+|\\d+)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.wscript",
          "match": "==|!=|>=|<=|>|<"
        },
        {
          "name": "keyword.operator.assignment.wscript",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.wscript",
          "match": "\\+|-|\\*|/"
        },
        {
          "name": "punctuation.separator.wscript",
          "match": "[{},().]"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.wscript",
          "match": "\\b(?:String|Int|Float|Bool)\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function.wscript",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.object.wscript",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\.)"
        },
        {
          "name": "variable.other.readwrite.wscript",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
